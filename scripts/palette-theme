#!/usr/bin/env python3
import os, re, shutil, subprocess, sys, time

D = os.environ.get("HOMEPAGE_DIR", "/home/USER/docker/homepage")
T = os.path.join(D, "theme")
FILES = [  # (config file, theme source, marker template)
    ("config/custom.css",    "theme.css",  "/* PALETTE-THEME-%s */"),
    ("config/custom.js",     "theme.js",   "// PALETTE-THEME-%s"),
    ("config/settings.yaml", "theme.yaml", "# PALETTE-THEME-%s"),
]
mode = sys.argv[1] if len(sys.argv) > 1 else ""
if mode not in ("on", "off"):
    sys.exit("usage: palette-theme on|off")

def strip(text, mk):
    pat = re.escape(mk % "START") + r".*?" + re.escape(mk % "END") + r"\n?"
    return re.sub(pat, "", text, flags=re.S).rstrip("\n") + "\n"

new = {}
for cfg, src, mk in FILES:
    path = os.path.join(D, cfg)
    text = strip(open(path).read(), mk)
    if mode == "on":
        body = open(os.path.join(T, src)).read().strip("\n")
        if cfg.endswith("settings.yaml"):
            for key in re.findall(r"^([A-Za-z]+):", body, re.M):
                if re.search(r"^%s:" % key, text, re.M):
                    sys.exit("settings.yaml already has '%s:' - nothing changed" % key)
        text += "\n" + (mk % "START") + "\n" + body + "\n" + (mk % "END") + "\n"
    new[path] = text

# validate everything before touching any file
try:
    import yaml
    yaml.safe_load(new[os.path.join(D, "config/settings.yaml")])
except ImportError:
    pass
except Exception as e:
    sys.exit("settings.yaml would be invalid, nothing changed: %s" % e)
node = shutil.which("node")
if node:
    tmp = "/tmp/palette-check.js"
    open(tmp, "w").write(new[os.path.join(D, "config/custom.js")])
    if subprocess.run([node, "--check", tmp], capture_output=True).returncode:
        sys.exit("custom.js would have a syntax error, nothing changed")

bk = os.path.join(T, "backups", time.strftime("%Y%m%d-%H%M%S") + "-%03d" % (int(time.time()*1000) % 1000))
os.makedirs(bk, exist_ok=True)
for cfg, _, _ in FILES:
    shutil.copy(os.path.join(D, cfg), bk)
for path, text in new.items():
    open(path, "w").write(text)
print("theme %s done. previous files saved in %s" % (mode, bk))
